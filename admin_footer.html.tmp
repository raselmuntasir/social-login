                <div class="flex flex-col items-center gap-2">
                    <p class="text-[11px] font-bold text-gray-400 tracking-widest uppercase">Top One Bazar © 2026</p>
                    <div class="h-1 w-8 bg-purple-500/20 rounded-full"></div>
                    <p class="text-[9px] text-gray-300 font-medium">All Right Reserved</p>
                </div>
            </div>
        </main>
    </div>

